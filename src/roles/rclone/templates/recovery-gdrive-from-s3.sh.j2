#!/bin/bash
# Restore selected Garage S3 buckets from Google Drive
# Managed by "homelab-iac"
#
# Only restores lightweight, stateful buckets. K8s-managed buckets
# (velero, longhorn) are intentionally excluded — they repopulate on cluster deploy.

# Ensure common paths are in PATH for cron and user flexibility
export PATH="/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

# Check if rclone is available
if ! command -v rclone &> /dev/null; then
    echo "Error: rclone not found in PATH." >&2
    exit 1
fi

BUCKETS=(
  "{{ adguard_bucket_name }}"
  "homelab-postgres"
)

for bucket in "${BUCKETS[@]}"; do
  echo "--- Restoring bucket: ${bucket} ---"
  rclone copy {{ gdrive_remote_name }}:${bucket} {{ garage_s3_remote_name }}:${bucket} \
    --progress \
    --transfers 8 \
    --checkers 16
done
