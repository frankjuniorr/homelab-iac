#!/bin/bash
# ⚠️ WARNING:
# This file is automatically generated by the "homelab-iac" project.
# Manual changes will be overwritten on the next Ansible run.

set -e

DUMP_NAME=$(date +%Y-%m-%d).sql.gz

echo "[$(date)] Starting postgres backup: ${DUMP_NAME}"

pg_dump -U postgres {{ postgres_db }} \
  | gzip \
  | rclone rcat {{ postgres_s3_remote_name }}:{{ postgres_s3_bucket }}/dumps/${DUMP_NAME} \
    --config {{ postgres_rclone_config_file }}

echo "[$(date)] Backup completed: ${DUMP_NAME}"
